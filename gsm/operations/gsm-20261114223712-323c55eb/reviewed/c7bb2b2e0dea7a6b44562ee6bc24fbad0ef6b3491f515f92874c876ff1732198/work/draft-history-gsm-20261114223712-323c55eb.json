          },
          "createdAt": "2026-11-14T21:20:06.922Z",
          "replyTo": "gsm-20261114223712-323c55eb-c01",
          "text": "太感谢了！",
          "likes": 5,
          "canon": "derivative",
          "media": []
        },
        {
          "id": "gsm-20261114223712-323c55eb-r02",
